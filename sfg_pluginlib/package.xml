<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sfg_pluginlib</name>
  <version>0.0.0</version>
  <description>Allows for safe usage of pluginlib::ClassLoader as non-static instances within
    composable nodes.</description>
  <maintainer email="constantin.blessing@hs-esslingen.de">Constantin Blessing</maintainer>
  <license>MIT</license>

  <depend>pluginlib</depend>
  <depend>sfg_utils</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>